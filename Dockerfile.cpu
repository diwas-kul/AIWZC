FROM python:3.8-slim

# Install system dependencies and WireGuard
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    wget \
    gnupg2 \
    lsb-release \
    ffmpeg \
    python3-opencv \
    iputils-ping \
    wireguard \
    wireguard-tools \
    iproute2 \
    openresolv \
    iptables \
    && rm -rf /var/lib/apt/lists/*

# Install iCommands
RUN wget -qO - https://packages.irods.org/irods-signing-key.asc | apt-key add - \
    && echo "deb [arch=amd64] https://packages.irods.org/apt/ $(lsb_release -sc) main" \
    | tee /etc/apt/sources.list.d/renci-irods.list \
    && apt-get update \
    && apt-get install -y irods-icommands \
    && rm -rf /var/lib/apt/lists/*

# Create a user with the same UID as your host user (default 1000)
RUN useradd -u 1000 -m irods_user \
    && mkdir -p /recordings \
    && chown -R irods_user:irods_user /recordings

# Create WireGuard directory
RUN mkdir -p /etc/wireguard && chmod 700 /etc/wireguard

# Set up application directory
WORKDIR /app

# Copy only requirements.txt first to leverage Docker cache
COPY --chown=irods_user:irods_user requirements.txt .

# Install base requirements 
RUN pip install --no-cache-dir -r requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir \
    psutil \
    tqdm \
    pyyaml \
    scikit-learn \
    scipy \
    imageio \
    opencv-python-headless \
    matplotlib pandas smplx h5py easydict ipdb visdom \
    cryptography pyopenssl gunicorn

# PyTorch (separate layer)
RUN pip install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

# Create mount point for Inference
RUN mkdir -p /app/Inference && chown -R irods_user:irods_user /app

# Copy the entrypoint script and make it executable
COPY --chown=root:root docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Expose the Flask port
EXPOSE 5000

# Use root to start the container (required for WireGuard)
USER root

# Start the API server using gunicorn, moved to docker-entrypoint.sh
# CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--timeout", "300", "api_server:app"]
ENTRYPOINT ["/app/docker-entrypoint.sh"]
