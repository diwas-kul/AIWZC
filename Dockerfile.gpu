FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

# Avoid timezone prompt during apt install
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-distutils \
    python3-pip \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    wget \
    gnupg2 \
    lsb-release \
    ffmpeg \
    python3-opencv \
    iputils-ping \
    wireguard \
    wireguard-tools \
    iproute2 \
    openresolv \
    iptables \
    && rm -rf /var/lib/apt/lists/*

# Make python3.10 the default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# Install pip for Python 3.10
RUN wget https://bootstrap.pypa.io/get-pip.py && \
    python3.10 get-pip.py && \
    rm get-pip.py

# Install iCommands
RUN wget -qO - https://packages.irods.org/irods-signing-key.asc | apt-key add - \
    && echo "deb [arch=amd64] https://packages.irods.org/apt/ $(lsb_release -sc) main" \
    | tee /etc/apt/sources.list.d/renci-irods.list \
    && apt-get update \
    && apt-get install -y irods-icommands \
    && rm -rf /var/lib/apt/lists/*

# Create a user with the same UID as your host user (default 1000)
RUN useradd -u 1000 -m irods_user \
    && mkdir -p /recordings \
    && chown -R irods_user:irods_user /recordings

    # Create WireGuard directory
RUN mkdir -p /etc/wireguard && chmod 700 /etc/wireguard

# Set up application directory
WORKDIR /app

# Copy only requirements.txt first to leverage Docker cache
COPY --chown=irods_user:irods_user requirements.txt .

# Install base requirements 
RUN python3.10 -m pip install --no-cache-dir -r requirements.txt

# Install NumPy and related packages first
RUN python3.10 -m pip install --no-cache-dir \
    'scipy<2.0' \
    'pandas<2.0'

# Install PyTorch ecosystem with specific CUDA version
RUN python3.10 -m pip install --no-cache-dir \
    torch==2.0.1+cu118 \
    torchvision==0.15.2+cu118 \
    --extra-index-url https://download.pytorch.org/whl/cu118

# Install additional dependencies with specific versions
RUN python3.10 -m pip install --no-cache-dir \
    psutil==5.9.5 \
    tqdm==4.65.0 \
    pyyaml==6.0.1 \
    scikit-learn==1.3.0 \
    imageio==2.31.1 \
    opencv-python-headless==4.8.0.76 \
    matplotlib==3.7.2 \
    smplx==0.1.28 \
    h5py==3.9.0 \
    easydict==1.10 \
    ipdb==0.13.13 \
    visdom==0.2.4

# Create mount point for Inference
RUN mkdir -p /app/Inference && chown -R irods_user:irods_user /app

# Copy the entrypoint script and make it executable
COPY --chown=root:root docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

# Expose the Flask port
EXPOSE 5000

# Switch to non-root/root user
# USER irods_user
USER root

# Start the API server using gunicorn
# CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--timeout", "300", "api_server:app"]
ENTRYPOINT ["/app/docker-entrypoint.sh"]
